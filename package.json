{
  "name": "ruta-saa-c03",
  "productName": "Ruta SAA-C03",
  "version": "1.4.0",
  "description": "Consola de preparación para el examen AWS Certified Solutions Architect - Associate (SAA-C03)",
  "main": "main.js",
  "author": "andre",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node scripts/test-engine.js && node scripts/test-glossary.js",
    "dist": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "pe.andre.rutasaa",
    "productName": "Ruta SAA-C03",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "node_modules/@fontsource*/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Ruta SAA-C03"
    },
    "portable": {
      "artifactName": "Ruta-SAA-C03-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0"
  }
}
